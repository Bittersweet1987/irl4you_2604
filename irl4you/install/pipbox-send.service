[Unit]
Description=IRL4YOU BOX Sendekette (Encoder und SRTLA-Sender)
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /opt/pipbox/pipbox_send.py
SuccessExitStatus=1
Restart=no
TimeoutStopSec=20
RuntimeDirectory=pipbox-send
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
