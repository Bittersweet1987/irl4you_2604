[Unit]
Description=IRL4YOU BOX RTMP-Eingang (SRS 6: H.264 und H.265)
After=network.target

[Service]
ExecStart=/usr/bin/irl4you-srs -c /etc/irl4you/srs.conf
Restart=always
RestartSec=2
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
# AF_NETLINK: SRS liest die Netzwerkkarten (getifaddrs) fuer seine Statistik, sonst startet es nicht ("stats.network=0")
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Ordner fuer die PID-Datei (ProtectSystem=strict: ./objs/srs.pid waere nicht beschreibbar)
RuntimeDirectory=irl4you-srs
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
