[Unit]
Description=IRL4YOU BOX WLAN-Stick mit AIC8800 in den WLAN-Modus schalten und prüfen
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/pipbox/pipbox-wlandriver.py auto
TimeoutStartSec=3min
Nice=10
# Root-Rechte nur für diese eine Aufgabe: Der Dienst nimmt keine Eingaben an (fester Aufruf "auto"), lädt höchstens ein Kernelmodul, schaltet den Stick per
# usb_modeswitch um, schreibt nur nach /run und kann keine neuen Rechte erlangen.
CapabilityBoundingSet=CAP_SYS_MODULE CAP_SYSLOG CAP_DAC_OVERRIDE CAP_FOWNER CAP_CHOWN
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/run
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectClock=yes
# ProtectClock sperrt sonst alle Geräteknoten, auch die des USB-Sticks (usb_modeswitch)
DeviceAllow=char-usb_device rw
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
