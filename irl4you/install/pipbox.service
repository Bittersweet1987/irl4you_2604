[Unit]
Description=IRL4YOU BOX Oberfläche (Port 8780 und 80)
After=network.target ModemManager.service

[Service]
ExecStart=/usr/bin/python3 /opt/pipbox/server.py --host 0.0.0.0 --port 8780 --extra-port 80 --state /var/lib/pipbox --rtmp-app publish --rtmp-stat-url http://127.0.0.1:1936/
# Port 80 (früher die BELABOX-Oberfläche) ohne root: nur dieses eine Recht
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
User=pipbox
Group=pipbox
SupplementaryGroups=bluetooth input
StateDirectory=pipbox
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
